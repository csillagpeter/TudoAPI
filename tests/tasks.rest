@Host= http://localhost
@Port= 3000
@Server={{Host}}:{{Port}}

### get all tasks

GET {{Server}}/api/tasks
Content-Type: application/json


### get one task
GET {{Server}}/api/tasks/1
Content-Type: application/json

### create a task
POST {{Server}}/api/tasks
Content-Type: application/json

{
    "title": "New Task",
    "description": "This is a new task",
    "deadline": "2023-12-31"
}

### update a task
PATCH {{Server}}/api/tasks/2
Content-Type: application/json

{
    "title": "Updated Task",
    "description": "This is an updated task",
    "deadline": "2023-12-31",
    "completed": true
}

### delete a task
DELETE {{Server}}/api/tasks/2
Content-Type: application/json

### delete all tasks
DELETE {{Server}}/api/tasks
Content-Type: application/json